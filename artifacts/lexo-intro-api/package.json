{
  "name": "@workspace/lexo-intro-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "prebuild": "tsx scripts/verify-static-audio.ts",
    "build": "node ./build.mjs",
    "verify:static-audio": "tsx scripts/verify-static-audio.ts",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:reading:prod": "tsx scripts/seed-reading.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.19.0",
    "@types/pdfkit": "^0.17.5",
    "@workspace/lexo-intro-db": "workspace:*",
    "@workspace/lexo-intro-integrations-anthropic": "workspace:*",
    "@workspace/lexo-intro-integrations-openai": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "drizzle-orm": "catalog:",
    "exceljs": "^4.4.0",
    "express": "^5",
    "google-auth-library": "^10.6.2",
    "multer": "^2.0.0",
    "pdfkit": "^0.18.0",
    "pino": "^9",
    "pino-http": "^10"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^1.4.12",
    "@types/node": "catalog:",
    "esbuild": "^0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13",
    "thread-stream": "3.1.0",
    "tsx": "catalog:",
    "vitest": "^3.2.4"
  }
}
