# =============================================================================
# Files that must NEVER end up in the Docker build context.
# Keeps the image small and prevents accidental secret leaks.
# =============================================================================

# Dependencies (re-installed inside the image)
node_modules
**/node_modules

# Build outputs (re-built inside the image)
dist
**/dist
build
**/build
.vite
**/.vite
.turbo
**/.turbo
.next
**/.next
*.tsbuildinfo

# Local caches & transient data
.cache
.local
.agents
.config

# Replit / IDE / VCS metadata
.git
.gitignore
.replit
replit.nix
.replitignore
.idea
.vscode
.DS_Store

# Secrets — never bake these into an image
.env
.env.*
!.env.example

# User-uploaded reference assets (not part of source)
attached_assets

# Previously generated export bundles
exports

# Logs
*.log
logs

# Mockup sandbox is dev-only; not needed in production runtime
artifacts/mockup-sandbox

# Docker artefacts
Dockerfile
.dockerignore
