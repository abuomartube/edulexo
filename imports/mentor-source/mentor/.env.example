# =====================================================================
# Mentor AI (Churchill + Orwell) — Environment Variables
# Copy this file to `.env` and fill in real values before running.
# =====================================================================

# ---- PostgreSQL database (required) ---------------------------------
# Any standard Postgres connection string. On Replit this is auto-provided
# by the built-in database; for self-hosting, point at your own Postgres.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# ---- OpenAI (required for Churchill AI: Speaking + Free Conversation) ---
# When self-hosting (no Replit AI Integrations proxy), set BASE_URL to
# OpenAI's public endpoint and API_KEY to your own OpenAI key.
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
AI_INTEGRATIONS_OPENAI_API_KEY=sk-your-openai-key-here

# ---- Anthropic (required for Orwell AI: Writing analyser) ---------------
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=https://api.anthropic.com
AI_INTEGRATIONS_ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# ---- Auth / sessions (required) -----------------------------------------
# Long random string used to sign session cookies for the student/admin auth.
SESSION_SECRET=replace-with-a-long-random-string

# ---- Runtime (optional) -------------------------------------------------
NODE_ENV=production
LOG_LEVEL=info

# Per-artifact dev port (only used by the Vite dev servers; production
# deploy targets read PORT from the platform).
PORT=8080
